    <string name="opendevice_directional_info_desc_tv">Petal Ads platformasi sizga moslangan reklamalarni taqdim etish uchun foydalanadigan reklama segmentatsiyasi axboroti bilan tanishish uchun telefoningiz yoki boshqa qurilmada Maxfiylik markaziga (%1$s) kiring.</string>
    <string name="opendevice_dlg_msg_ad_reset">Tasodifiy tarzda yaratilgan yangi reklama identifikatori tayinlanadi.</string>
    <string name="opendevice_dlg_title_reset_ad">Reklama identifikatorini tiklash</string>
    <string name="opendevice_here">bu yerga</string>
    <string name="opendevice_hw_ad_service">Ads va maxfiylik</string>
    <string name="opendevice_hw_ad_service_new">Reklamalar</string>
    <string name="opendevice_item_ad_reset_desc">Reklama-ID identifikatoringizdan foydalanadigan moslangan reklamalarni olishni rad etishingiz mumkin. Rad etgandan keyin ham reklamalarni olishda davom etasiz, lekin ular sizga kamroq aloqador boʻladi. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Maʼlumotlardan foydalanish va huquqlaringiz tafsilotlari</string>
    <string name="opendevice_item_disable_collection_ad">Reklama identifikatori statistikasini olishni faolsizlantirish</string>
    <string name="opendevice_item_disable_collection_ad_desc">Xizmatlarimizni rivojlantirish maqsadida, ushbu sozlamalar ekranida bajargan amallaringiz hamda Reklama identifikatoringizdan foydalanadigan ilovalar haqidagi axborotlarni olamiz. Bu maʼlumotlardan qanday foydalanishimizni bilish uchun %1$s bosing.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Xizmatlarimizni rivojlantirish maqsadida, ushbu sozlamalar ekranida bajargan amallaringiz hamda Reklama identifikatoringizdan foydalanadigan ilovalar haqidagi axborotlarni olamiz.</string>
    <string name="opendevice_item_more_settings">Batafsil</string>
    <string name="opendevice_item_oaid_desc">Reklama-ID identifikatoringiz (OAID deb ham ataladi) – bu sizga moslangan reklamalarni taqdim etish uchun ishlatiladigan vaqtinchalik qurilma identifikatoridir.</string>
    <string name="opendevice_item_reset_ad">Reklama identifikatorini tiklash</string>
    <string name="opendevice_item_reset_ad_des">Reklama identifikatoringizdan foydalanadigan moslangan reklamalarni olishni rad etishingiz mumkin. Rad etgandan keyin ham reklamalarni olishda davom etasiz, lekin ular sizga kamroq aloqador boʻladi.</string>
    <string name="opendevice_item_reset_ad_des_new">Reklama-ID identifikatoringizdan foydalanadigan moslangan reklamalarni olishni rad etishingiz mumkin. Rad etgandan keyin ham reklamalarni olishda davom etasiz, lekin ular sizga kamroq aloqador boʻladi.</string>
    <string name="opendevice_item_your_oaid">OAID identifikatoringiz</string>
    <string name="opendevice_item_your_oaid_desc">Reklama identifikatoringiz (OAID deb ham ataladi) – bu sizga moslangan reklamalarni taqdim etish uchun ishlatiladigan vaqtinchalik qurilma identifikatoridir. Tafsilotlar uchun bosing %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Moslangan reklamalarni faolsizlantirish</string>
    <string name="opendevice_limit_ad_tracking_detail">Batafsil</string>
    <string name="opendevice_limit_recommend">Smart tavsiyalar</string>
    <string name="opendevice_network_no_available">Internetga ulanmagansiz</string>
    <string name="opendevice_personalized_info_desc">Siz ilovalar sozlamalarida “Moslangan reklamalar” bandini faolsizlantirish orqali ularning moslangan reklamalarni taqdim etish uchun ushbu axborotdan foydalanishining oldini olishingiz mumkin. Bu faolsizlantirilsa, sizga namoyish etiladigan reklamalarning soni oʻzgarmaydi, lekin ular sizga kamroq aloqador boʻladi.</string>
    <string name="opendevice_petal_info_desc_tv">HUAWEI Ads – bu Huawei Software Technologies Co., Ltd. tomonidan Petal Ads platformasi orqali taqdim etiladigan reklama xizmatidir. Bu xizmatdan foydalanganingizda maxfiyligingiz himoyalanadi. Batafsil axborot uchun quyidagilar bilan tanishing:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Barcha ilovalarning kuzatishiga ruxsat</string>
    <string name="opendevice_pps_privacy_info_desc_more">Batafsil</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Bu yoqilsa, barcha ilovalar reklama identifikatoringizni (OAID) olishi mumkin. Bu faolsizlantirilsa, faqat quyidagi tanlangan ilovalarga ruxsat beriladi.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Ochiq anonim qurilma identifikatoringiz (OAID) – bu ilova dasturchilariga faolliklaringizni shaxsiy ma’lumotlaringizni olmasdan kuzatish va moslangan kontentni taqdim etish imkonini beradigan vaqtinchalik qurilma identifikatoridir. Agar kuzatuvni barcha ilovalar uchun faolsizlantirgan boʻlsangiz, keyingi safar biror ilovaning faolliklaringizni kuzatishiga ruxsat berganingizda yangi OAID tayinlanadi.</string>
    <string name="opendevice_pps_privacy_petal_ads">HUAWEI Ads</string>
    <string name="opendevice_pps_privacy_track_app_info">Xatti-harakatlaringizni identifikatoringiz bilan kuzatishni soʻragan ilovalar shu yerda koʻrsatiladi. Siz taqiqlagan ilovalarning xatti-harakatlarni kuzatishiga ruxsat berilmaydi.</string>
    <string name="opendevice_pps_privacy_view_oaid">OAID axborotini ochish</string>
    <string name="opendevice_privacy_desc">Moslangan reklama xizmatlari sizni qiziqtirishi mumkin boʻlgan kontentni tavsiya qiladi. Maxfiyligingiz har doim himoya qilinadi. Tafsilotlar uchun %1$s bilan tanishing.</string>
    <string name="opendevice_privacy_desc_new">Moslangan reklama xizmatlari sizni qiziqtirishi mumkin boʻlgan kontentni tavsiya qiladi. Maxfiyligingiz har doim himoya qilinadi. Tafsilotlar uchun quyidagilar bilan tanishing:</string>

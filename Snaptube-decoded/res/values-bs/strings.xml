    <string name="opendevice_directional_info_desc_tv">Da biste vidjeli informacije o segmentaciji oglašavanja koje platforma Petal oglasi koristi za pružanje personaliziranih oglasa, idite u Centar za privatnost (%1$s) na telefonu ili drugom uređaju.</string>
    <string name="opendevice_dlg_msg_ad_reset">Novi ID oglasa će se nasumično dodijeliti.</string>
    <string name="opendevice_dlg_title_reset_ad">Resetiraj ID oglasa</string>
    <string name="opendevice_here">ovdje</string>
    <string name="opendevice_hw_ad_service">Oglasi i privatnost</string>
    <string name="opendevice_hw_ad_service_new">Oglasi</string>
    <string name="opendevice_item_ad_reset_desc">Možete otkazati primanje personaliziranih oglasa koji koriste vaš ID za oglašavanje. Ako otkažete ovu uslugu, i dalje ćete primati oglase, ali oni mogu biti manje relevantni za vas. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Saznajte više o korištenju podataka i vašim pravima</string>
    <string name="opendevice_item_disable_collection_ad">Onemogući prikupljanje statistike ID oglasa</string>
    <string name="opendevice_item_disable_collection_ad_desc">Prikupljamo informacije o vašim radnjama na ekranu u ovim postavkama i aplikacijama koje koriste vaš ID oglasa kako bismo poboljšali naše usluge. Za više informacija o tom kako koristimo te podatke, dodirnite %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Prikupljamo informacije o radnjama na ekranu u ovim postavkama i o aplikacijama koje koriste vaš ID oglasa u cilju poboljšanja usluga.</string>
    <string name="opendevice_item_more_settings">Više informacija</string>
    <string name="opendevice_item_oaid_desc">Vaš ID za oglašavanje (poznat i kao OAID) je privremeni identifikator uređaja koji se koristi za pružanje personaliziranih oglasa.</string>
    <string name="opendevice_item_reset_ad">Resetiraj ID oglasa</string>
    <string name="opendevice_item_reset_ad_des">Možete se isključiti iz primanja personaliziranih oglasa koji koriste vaš ID oglasa. Ako se isključite i dalje ćete primati oglase, ali se može desiti da budu manje relevantni.</string>
    <string name="opendevice_item_reset_ad_des_new">Možete odustati od primanja personaliziranih oglasa koji koriste vaš ID za oglase. Ako odustanete, i dalje ćete primati oglase, ali oni mogu biti manje relevantni za vas.</string>
    <string name="opendevice_item_your_oaid">Vaš OAID</string>
    <string name="opendevice_item_your_oaid_desc">Vaš ID oglasa (poznat i kao OAID) je privremeni identifikator uređaja koji se koristi za pružanje personaliziranih oglasa. Za više informacija dodirnite %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Onemogući personalizirane oglase</string>
    <string name="opendevice_limit_ad_tracking_detail">Saznajte više</string>
    <string name="opendevice_limit_recommend">Pametne preporuke</string>
    <string name="opendevice_network_no_available">Nema internetske veze</string>
    <string name="opendevice_personalized_info_desc">Možete spriječiti da aplikacije koriste ove podatke za pružanje personaliziranih oglasa tako što ćete onemogućiti opciju \"Personalizirani oglasi\" u njihovim postavkama. Kada je ova opcija onemogućena, i dalje ćete primati isti broj oglasa, ali će oni biti manje relevantni za vas.</string>
    <string name="opendevice_petal_info_desc_tv">HUAWEI oglasi je usluga za oglašavanje koju pruža kompanija Huawei Software Technologies Co., Ltd. putem platforme Petal oglasi. Vaša privatnost je zaštićena prilikom korištenja ove usluge. Za više informacija pogledajte sljedeće:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Dozvoli svim aplikacijama praćenje</string>
    <string name="opendevice_pps_privacy_info_desc_more">Saznajte više</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Kada se ova opcija omogući, sve aplikacije mogu pristupiti identifikatoru za oglašavanje (OAID). Kada se ova opcija onemogući, pristup je dozvoljen samo aplikacijama navedenim ispod.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Otvoreni anonimni identifikator uređaja (OAID) je netrajni identifikator uređaja koji omogućava programerima aplikacije da prate vašu aktivnost i dostave personalizirani sadržaj bez otkrivanja vaših ličnih podataka. Ako ste onemogućili praćenje za sve aplikacije, bit će vam dodijeljen novi OAID sljedeći put kada dozvolite aplikaciji da prati vašu aktivnost.</string>
    <string name="opendevice_pps_privacy_petal_ads">HUAWEI oglasi</string>
    <string name="opendevice_pps_privacy_track_app_info">Aplikacije koje su tražile da prate vašu aktivnost putem identifikatora će biti prikazane ovdje. Praćenje aktivnosti se blokira za aplikacije kojima odbijete pristup.</string>
    <string name="opendevice_pps_privacy_view_oaid">Prikaži OAID</string>
    <string name="opendevice_privacy_desc">Personalizirane usluge oglašavanja preporučuju sadržaj koji bi vama mogao biti zanimljiv. Vaša privatnost će biti zaštićena u svakom trenutku. Za više detalje pogledajte dokument %1$s.</string>
    <string name="opendevice_privacy_desc_new">Usluge personaliziranog oglašavanja preporučuju sadržaj koji bi vas mogao zanimati. Privatnost je u svakom trenutku zaštićena. Za više informacija pogledajte sljedeće:</string>
    <string name="opendevice_privacy_oversea_desc">Platforma za Petal oglase omogućava usluge oglašavanja za aplikaciju Huawei mobile services i aplikacije treće strane. Ako su omogućeni personalizirani oglasi, vaši lični podaci se mogu koristiti kako bi vam se pružili relevantniji i korisniji oglasi. Da saznate više o načinu na koji se koriste vaši podaci i o svojim pravima pročitajte dokument %1$s.</string>
    <string name="opendevice_privacy_oversea_desc_new">Platforma Petal oglasi omogućava usluge oglašavanja za Huawei mobilne usluge i aplikacije trećih strana. Ako su omogućeni personalizirani oglasi, vaši lični podaci se mogu koristiti kako bi vam se pružili relevantniji i korisniji oglasi. Da saznate više o tome kako se koriste podaci i o svojim pravima, pročitajte sljedeće:</string>
    <string name="opendevice_recommend_ad_desc">Huawei pruža oglase koji bi vam mogli biti korisni uz korištenje naprednih tehnologija kako bi se osigurala zaštita vaše privatnosti.</string>

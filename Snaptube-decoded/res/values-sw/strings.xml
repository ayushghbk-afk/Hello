    <string name="opendevice_directional_info">Tazama maelezo ya kulenga tangazo</string>
    <string name="opendevice_directional_info_desc_tv">Ili kutazama maelezo ya uanishaji wa utangazaji ambayo jukwaa la Matangazo ya Petal hutumia ili kukupatia matangazo yaliyobinafsishwa, nenda kwenye Kituo cha faragha (%1$s) kwenye simu yako au kifaa kingine.</string>
    <string name="opendevice_dlg_msg_ad_reset">Kitambulisho kipya cha Tangazo kitateuliwa bila mpango.</string>
    <string name="opendevice_dlg_title_reset_ad">Weka upya Kitambulisho cha Tangazo</string>
    <string name="opendevice_here">hapa</string>
    <string name="opendevice_hw_ad_service">Matangazo na faragha</string>
    <string name="opendevice_hw_ad_service_new">Matangazo</string>
    <string name="opendevice_item_ad_reset_desc">Unaweza kuchagua kutoka ili usipokee matangazo yaliyobinafsishwa yanayotumia Kitambulisho chako cha Tangazo. Ukichagua kutoka, bado utapokea matangazo, lakini huenda yakawa hayakuhusu sana. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Jifunze zaidi kuhusu matumizi ya data na kuhusu haki zako</string>
    <string name="opendevice_item_disable_collection_ad">Lemaza ukusanyaji wa takwimu za Kitambulisho cha Tangazo</string>
    <string name="opendevice_item_disable_collection_ad_desc">Tutakusanya maelezo kuhusu matendo yako kwenye skrini ndani ya mipangilio hii na maelezo kuhusu programu zinazotumia Kitambulisho chako cha Tangazo ili kuboresha huduma zetu. Ili kupata maelezo zaidi kuhusu jinsi tunavyokusanya data hii, gusa %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Tutakusanya maelezo kuhusu matendo yako kwenye skrini ndani ya mipangilio hii na kuhusu programu zinazotumia Kitambulisho chako cha Tangazo ili kuboresha huduma zetu.</string>
    <string name="opendevice_item_more_settings">Maelezo zaidi</string>
    <string name="opendevice_item_oaid_desc">Kitambulisho chako cha Tangazo (ambacho pia kinajulikana kama OAID) ni kitambuaji kifaa cha muda kinachotumiwa kukupatia matangazo yaliyobinafsishwa.</string>
    <string name="opendevice_item_reset_ad">Weka upya Kitambulisho cha Tangazo</string>
    <string name="opendevice_item_reset_ad_des">Unaweza kuchagua kutoka ili usipokee matangazo yaliyobinafsishwa yanayotumia Kitambulisho chako cha Tangazo. Ukichagua kutoka, bado utapokea matangazo, lakini huenda yakawa hayakuhusu sana.</string>
    <string name="opendevice_item_reset_ad_des_new">Unaweza kuchagua kutoka usipokee matangazo yaliyobinafsishwa yanayotumia Kitambulisho chako cha Tangazo. Ukichagua kutoka, bado utapokea matangazo, lakini huenda yakawa hayakuhusu sana.</string>
    <string name="opendevice_item_your_oaid">OAID yako</string>
    <string name="opendevice_item_your_oaid_desc">Kitambulisho chako cha Tangazo (ambacho pia kinajulikana kama OAID) ni kitambuaji kifaa cha muda kinachotumiwa kukupatia matangazo yaliyobinafsishwa. Ili kupata maelezo zaidi, gusa %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Lemaza matangazo yaliyobinafsishwa</string>
    <string name="opendevice_limit_ad_tracking_detail">Jifunze zaidi</string>
    <string name="opendevice_limit_recommend">Mapendekezo Maizi</string>
    <string name="opendevice_network_no_available">Hakuna muunganisho wa Intaneti</string>
    <string name="opendevice_personalized_info_desc">Unaweza kuzuia programu kutotumia data hii ili kutoa matangazo yaliyobinafsishwa kwa kulemaza \"Matangazo yaliyobinafsishwa\" katika mipangilio yao. Pindi inapolemazwa, bado utapokea idadi sawa ya matangazo, lakini hayatakuwa na maana kwako.</string>
    <string name="opendevice_petal_info_desc_tv">Matangazo ya HUAWEI ni huduma ya utangazaji inayotolewa na Huawei Software Technologies Co., Ltd. kupitia jukwaa la Matangazo ya Petal. Faragha yako inalindwa unapotumia huduma hii. Ili kupata maelezo zaidi, rejelea yafuatayo:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Ruhusu programu zote zifuatilie</string>
    <string name="opendevice_pps_privacy_info_desc_more">Jifunze zaidi</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Inapowezeshwa, programu zote zinaweza kufikia kitambuaji chako cha utangazaji (OAID). Inapolemazwa, ni tu programu zilizochaguliwa hapa chini zinaruhusiwa kufikia.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Kitambuaji Kifaa chako Wazi Kisicho na Jina (OAID) ni kitambuaji kifaa kisicho cha kudumu ambacho huruhusu watengenezaji wa programu ili kufuatilia shughuli yako na kupatiana maudhui yaliyobinafsishwa bila kuonyesha data yako ya kibinafsi. Ikiwa umelemaza kufuatilia kwa programu zote, OAID mpya itapeanwa wakati ufuatao unaruhusu programu kufuatilia shughuli yako.</string>
    <string name="opendevice_pps_privacy_petal_ads">Matangazo ya HUAWEI</string>
    <string name="opendevice_pps_privacy_track_app_info">Programu ambazo zimeomba kufuatilia shughuli yako kupitia kitambuaji chako zitaonyeshwa hapa. Shughuli ya ufuatilizi imezuiwa kwa programu unazozinyima ufikiaji.</string>
    <string name="opendevice_pps_privacy_view_oaid">Tazama OAID</string>
    <string name="opendevice_privacy_desc">Huduma zilizobinafsishwa za utangazaji zinapendekeza maudhui yanayoweza kukuvutia. Faragha yako italindwa daima. Ili kupata maelezo zaidi, tafadhali tazama %1$s.</string>
    <string name="opendevice_privacy_desc_new">Huduma zilizobinafsishwa za utangazaji zinapendekeza maudhui yanayoweza kukuvutia. Faragha yako italindwa kwenye nyakati zote. Ili kupata maelezo zaidi, tafadhali tazama yafuatayo:</string>
    <string name="opendevice_privacy_oversea_desc">Jukwaa la Matangazo ya Petal hupatiana huduma za utangazaji kwa Huawei mobile services na programu za mhusika mwingine. Matangazo yaliyobinafsishwa yakiwezeshwa, data yako ya kibinafsi inaweza ikatumiwa ili kukupatia matangazo zaidi yanayosaidia na husika. Ili kupata maelezo zaidi kuhusu jinsi data yako inatumiwa na kuhusu haki zako, tafadhali rejelea %1$s.</string>
    <string name="opendevice_privacy_oversea_desc_new">Jukwaa la Matangazo ya Petal hupatiana huduma za utangazaji kwa huduma za simu ya Huawei na programu za mtu mwingine. Ikiwa matangazo yaliyobinafsishwa yamewezeshwa, data yako ya kibinafsi inaweza kutumiwa kukupatia matangazo zaidi husika na yenye manufaa. Ili kupata maelezo zaidi kuhusu jinsi data yako inatumiwa na kuhusu haki zako, tafadhali rejelea yafuatayo:</string>
    <string name="opendevice_recommend_ad_desc">Huawei hukupatia matangazo ambayo yanayoweza kukufaa huku ikitumia teknolojia mahiri kuhakikisha kuwa faragha yako inalindwa.</string>
    <string name="opendevice_recommend_desc">Kipengele hiki hutumia teknolojia ya mafunzo shirikishi ili kupendekeza bidhaa na huduma ambazo huenda utapenda.</string>

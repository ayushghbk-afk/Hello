    <string name="opendevice_pps_privacy_info_desc_more">ვრცლად</string>
    <string name="opendevice_pps_privacy_info_desc_tv">როცა ჩართულია, ყველა აპს შეუძლია წვდომა თქვენს სარეკლამო იდენტიფიკატორზე (OAID). როცა გამორთულია, წვდომა დაშვებულია მხოლოდ ქვემოთ არჩეული აპებისთვის.</string>
    <string name="opendevice_pps_privacy_oaid_desc">მოწყობილობის ღია ანონიმური იდენტიფიკატორი (OAID) არის მოწყობილობის არამუდმივი იდენტიფიკატორი, რომელიც აპების დეველოპერებს საშუალებას აძლევს, თვალყური ადევნონ თქვენს აქტივობას და მოგაწოდოთ პერსონალიზებული შიგთავსი თქვენი პერსონალური მონაცემების გამჟღავნების გარეშე. თუ გამორთული გაქვთ თვალის დევნება ყველა აპისთვის, შემდეგ ჯერზე, როცა აპს თქვენს აქტივობაზე თვალის დევნების ნებას დართავთ, მოგენიჭებათ ახალი OAID.</string>
    <string name="opendevice_pps_privacy_petal_ads">HUAWEI რეკლამები</string>
    <string name="opendevice_pps_privacy_track_app_info">აპები, რომლებმაც მოითხოვა თქვენს აქტივობაზე თვალყურის დევნება თქვენი იდენტიფიკატორით, ნაჩვენები იქნება აქ. აქტივობაზე თვალყურის დევნება დაბლოკილია იმ აპებისთვის, რომლებზე წვდომასაც უარყოფთ.</string>

    <string name="opendevice_directional_info">Zobrazení informací o cílení reklam</string>
    <string name="opendevice_directional_info_desc_tv">Chcete-li zobrazit informace o segmentaci reklam, které platforma Petal Reklamy používá k poskytování přizpůsobených reklam, přejděte na svém telefonu nebo jiném zařízení do Centra soukromí (%1$s).</string>
    <string name="opendevice_dlg_msg_ad_reset">Bude náhodně přiřazeno nové Ad-ID.</string>
    <string name="opendevice_dlg_title_reset_ad">Resetovat Ad-ID</string>
    <string name="opendevice_here">sem</string>
    <string name="opendevice_hw_ad_service">Reklamy a soukromí</string>
    <string name="opendevice_hw_ad_service_new">Reklamy</string>
    <string name="opendevice_item_ad_reset_desc">Můžete vypnout přizpůsobování reklam, které používají vaše reklamní ID. Pokud službu vypnete, reklamy se vám budou zobrazovat i nadále, ale mohou pro vás být méně relevantní. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Zjistěte více o používání dat a o svých právech</string>
    <string name="opendevice_item_disable_collection_ad">Zakázat sběr statistiky reklamního ID</string>
    <string name="opendevice_item_disable_collection_ad_desc">K vylepšování našich služeb budeme shromažďovat informace o akcích na obrazovce v tomto nastavení a o aplikacích, které používají vaše Ad-ID. Pro více informací o způsobu využití těchto dat klepněte na %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Kvůli vylepšování našich služeb budeme shromažďovat informace o akcích na obrazovce v tomto nastavení a o aplikacích, které používají vaše Ad-ID.</string>
    <string name="opendevice_item_more_settings">Další informace</string>
    <string name="opendevice_item_oaid_desc">Vaše reklamní ID (známé také jako OAID) je dočasný identifikátor zařízení používaný k poskytování přizpůsobených reklam.</string>
    <string name="opendevice_item_reset_ad">Resetovat Ad-ID</string>
    <string name="opendevice_item_reset_ad_des">Můžete vypnout přizpůsobování reklam, které používají vaše Ad-ID. Pokud službu vypnete, reklamy se vám budou zobrazovat i nadále, ale mohou pro vás být méně relevantní.</string>
    <string name="opendevice_item_reset_ad_des_new">Můžete se odhlásit z přijímání personalizovaných reklam, které používají vaše reklamní ID. Pokud se odhlásíte, budete i nadále dostávat reklamy, ale mohou být pro vás méně relevantní.</string>
    <string name="opendevice_item_your_oaid">Váš OAID</string>
    <string name="opendevice_item_your_oaid_desc">Vaše Ad-ID (známé také jako OAID) je dočasný identifikátor zařízení používaný k poskytování přizpůsobených reklam. Chcete-li získat další informace, klepněte %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Vypnout personalizované reklamy</string>
    <string name="opendevice_limit_ad_tracking_detail">Zjistit více</string>
    <string name="opendevice_limit_recommend">Chytrá doporučení</string>
    <string name="opendevice_network_no_available">Žádné připojení k internetu</string>
    <string name="opendevice_personalized_info_desc">Aplikacím můžete zabránit v používání těchto dat k poskytování personalizovaných reklam tím, že v jejich nastavení vypnete možnost „Přizpůsobené reklamy“. Po vypnutí budete stále dostávat stejný počet reklam, ale budou pro vás méně relevantní.</string>
    <string name="opendevice_petal_info_desc_tv">Reklamy HUAWEI je reklamní služba poskytovaná společností Huawei Software Technologies Co., Ltd. prostřednictvím platformy Petal Reklamy. Vaše soukromí je během používání této služby chráněno. Více informace najdete zde:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Povolit sledování všem aplikacím</string>
    <string name="opendevice_pps_privacy_info_desc_more">Další informace</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Pokud je tato funkce zapnuta, všechny aplikace budou mít přístup k vašemu identifikátoru pro reklamu (OAID). Pokud je tato funkce vypnuta, přístup budou mít pouze níže vybrané aplikace.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Anonymní identifikátor zařízení (OAID) je dočasný identifikátor zařízení, který umožňuje vývojářům aplikací sledovat vaši aktivitu a poskytovat personalizovaný obsah bez odhalení vašich osobních údajů. Pokud jste deaktivovali sledování u všech aplikací, bude nový OAID přiřazený příště, až aplikaci povolíte sledování vaší aktivity.</string>
    <string name="opendevice_pps_privacy_petal_ads">Reklamy HUAWEI</string>
    <string name="opendevice_pps_privacy_track_app_info">Zde se zobrazí aplikace, které požádaly o sledování vaší aktivity pomocí vašeho identifikátoru. Sledování aktivity je zablokováno pro aplikace, ke kterým odepřete přístup.</string>
    <string name="opendevice_pps_privacy_view_oaid">Zobrazit OAID</string>

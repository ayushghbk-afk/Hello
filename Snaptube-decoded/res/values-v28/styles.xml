    <style name="P4.Theme.AdSplash" parent="@style/P4.Theme.NoActionBar">
        <item name="android:windowBackground">@color/splash_color</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="P4.Theme.Splash.Explore" parent="@style/DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:dropDownListViewStyle">@style/P4.Widget.ListView.DropDown</item>
        <item name="android:textColor">@color/content_main</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:listPopupWindowStyle">@style/P4.Widget.Popup</item>
        <item name="android:popupMenuStyle">@style/P4.Widget.Popup</item>
        <item name="android:textDirection">locale</item>
        <item name="android:statusBarColor">@color/bg_status_bar</item>
        <item name="android:navigationBarColor">@color/splash_color</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="SubActionButtonStyle">@style/ST.SubActionButtonStyle</item>
        <item name="actionBarStyle">@style/ActionBar.MultiTabActivity</item>
        <item name="actionButtonStyle">@style/P4.ActionBar.ActionButton</item>

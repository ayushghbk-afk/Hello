        <item name="colorControlActivated">@color/text_accent_color</item>
        <item name="contentBackground">@color/background_content_color</item>
        <item name="dividerHorizontal">@color/divider</item>
        <item name="dividerVertical">@color/divider</item>
        <item name="dropDownListViewStyle">@style/P4.Widget.ListView.DropDown</item>
        <item name="preferenceTheme">@style/P4.Theme.Preference</item>
        <item name="signInTextStyle">@style/SignInTextView</item>
        <item name="toolbarStyle">@style/Base.Widget.Toolbar</item>
        <item name="verticalButtonBackground">@drawable/bg_card_button_drawable_selector_home</item>
        <item name="verticalColor">@color/light_red</item>
        <item name="verticalFilterDrawable">@drawable/bg_filter_item_home</item>
        <item name="verticalId">@id/vertical_home</item>
        <item name="verticalNormalColor">@color/light_red</item>
        <item name="verticalProgressDrawable">@drawable/bg_progress_bar_home</item>
        <item name="verticalTabTextColor">@color/color_tab_home</item>
        <item name="windowActionModeOverlay">true</item>
    </style>
    <style name="P4.Theme.Splash.LaunchGuide" parent="@style/P4.Theme.RootActivity">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="actionModeBackground">@color/transparent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

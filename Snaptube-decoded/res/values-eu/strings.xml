    <string name="opendevice_here">hemen</string>
    <string name="opendevice_hw_ad_service">Ads eta pribatutasuna</string>
    <string name="opendevice_hw_ad_service_new">Iragarkiak</string>
    <string name="opendevice_item_ad_reset_desc">Iragarki IDa erabiltzen duten iragarki pertsonalizatuak jasotzea desauta dezakezu. Desautatzen baduzu, iragarkiak jasotzen jarraituko duzu baina ez dira hain esanguratsuak izango. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Lortu informazio gehiago datu horiek erabiltzeko moduari eta zure eskubideei buruz</string>
    <string name="opendevice_item_disable_collection_ad">Desgaitu iragarki-IDen estatistikak biltzea</string>
    <string name="opendevice_item_disable_collection_ad_desc">Ezarpen horien pantailako ekintzei eta iragarki-IDa erabiltzen duten aplikazioei buruzko informazioa bilduko dugu, gure zerbitzuak hobetzeko. Datu horiek erabiltzeko moduari buruzko informazio gehiago lortzeko, ukitu %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Ezarpen horietan bilduko dugu pantailako ekintzei eta iragarki IDa erabiltzen duten aplikazioei buruzko informazioa, gure zerbitzuak hobetzeko.</string>
    <string name="opendevice_item_more_settings">Informazio gehiago</string>
    <string name="opendevice_item_oaid_desc">Zure Iragarkiaren IDa (OAID gisa ere ezagutzen dena) aldi baterako gailu-identifikatzailea da, iragarki pertsonalizatuak emateko erabiltzen duguna.</string>
    <string name="opendevice_item_reset_ad">Berrezarri iragarkiaren IDa</string>
    <string name="opendevice_item_reset_ad_des">Iragarki IDa erabiltzen duten iragarki pertsonalizatuak jasotzea desauta dezakezu. Desautatzen baduzu, iragarkiak jasotzen jarraituko duzu baina ez dira hain esanguratsuak izango.</string>
    <string name="opendevice_item_reset_ad_des_new">Zure iragarki-IDa erabiltzen duten iragarki pertsonalizatuak jasotzeko aukera desgai dezakezu. Desautatzen baduzu, iragarkiak jasotzen jarraituko duzu baina ez dira hain esanguratsuak izango.</string>
    <string name="opendevice_item_your_oaid">Zure OAID</string>
    <string name="opendevice_item_your_oaid_desc">Zure Iragarkiaren IDa (OAID gisa ere ezagutzen dena) aldi baterako gailu-identifikatzailea da, iragarki pertsonalizatuak emateko erabiltzen duguna. Informazio gehiago lortzeko, ukitu %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Desgaitu iragarki pertsonalizatuak</string>
    <string name="opendevice_limit_ad_tracking_detail">Informazio gehiago</string>
    <string name="opendevice_limit_recommend">Gomendio adimendunak</string>
    <string name="opendevice_network_no_available">Ez dago Interneteko konexiorik</string>
    <string name="opendevice_personalized_info_desc">Aplikazioek iragarki pertsonalizatuak emateko datu horiek ez erabiltzeko, desgaitu “Iragarki pertsonalizatuak” ezarpenetan. Aukera desgaitu eta gero, iragarki kopuru bera jasotzen jarraituko duzu baina ez dira hain interesgarriak izango.</string>
    <string name="opendevice_petal_info_desc_tv">HUAWEI Ads Huawei Software Technologies Co., Ltd. enpresak Petal Ads plataformaren bidez ematen duen publizitate-zerbitzua da. Zerbitzua erabiltzen duzunean, pribatutasuna babestuta dago. Informazio gehiago lortzeko, ikusi:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Eman aplikazio guztiei jarraipena egiteko baimena</string>
    <string name="opendevice_pps_privacy_info_desc_more">Informazio gehiago</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Gaituta dagoenean, aplikazio guztiek iragarkiaren identifikatzailea (OAID) atzi ditzakete. Desgaituta dagoenean, behean hautatutako aplikazioei soilik onartzen zaie atzitzea.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Gailu-identifikatzaile anonimo irekia (OAID) behin-behineko gailu-identifikatzailea da eta aplikazioen garatzaileei zure jardueraren jarraipena egitea eta eduki pertsonalizatua eskaintzea ahalbidetzen die, zure datu pertsonalak ezagutarazi gabe. Aplikazio guztien jarraipena egitea desgaitu baduzu, OAID berri bat esleituko zaio aplikazio bati zure jardueraren jarraipena egiten uzten diozun hurrengoan.</string>
    <string name="opendevice_pps_privacy_petal_ads">HUAWEI Ads</string>
    <string name="opendevice_pps_privacy_track_app_info">Hemen erakutsiko dira zure identifikatzailearekin jardueraren jarraipena egiteko eskatu duten aplikazioak. Blokeatuta dago sarbidea atzitu diezun aplikazioen jardueraren jarraipena egitea.</string>
    <string name="opendevice_pps_privacy_view_oaid">Ikusi OAID</string>
    <string name="opendevice_privacy_desc">Publizitate-zerbitzu pertsonalizatuek interesa dakizukeen edukia gomendatzen dizute. Pribatutasuna babestuta izango da une oro. Gehiago jakiteko, ikusi %1$s.</string>
    <string name="opendevice_privacy_desc_new">Publizitate-zerbitzu pertsonalizatuek interesa dakizkizukeen edukia gomendatzeko. Zure pribatutasuna babestuta izango da une oro. Informazio gehiago lortzeko, ikusi hau:</string>
    <string name="opendevice_privacy_oversea_desc">Petal Ads plataformak Huawei-ren mugikorretarako zerbitzuen eta hirugarrenen aplikazioen publizitate-zerbitzuak ematen ditu. Iragarki pertsonalizatuak gaituta badaude, baliteke zure datu pertsonalak iragarki esanguratsuago eta erabilgarriagoak emateko erabiltzea. Zure datuak erabiltzeko moduari eta dituzun eskubideei buruzko informazio gehiago lortzeko, ikusi %1$s.</string>

    <string name="opendevice_item_disable_collection_ad">השבת איסוף של סטטיסטיקות Ad-ID</string>
    <string name="opendevice_item_disable_collection_ad_desc">אנו נאסוף מידע אודות הפעולות שלך על-גבי המסך בהגדרות אלה ואודות יישומים שמשתמשים ב-Ad-ID שלך, כדי לשפר את השירותים שלנו. למידע נוסף אודות האופן שבו אנו משתמשים במידע זה, גע %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">אנו נאסוף מידע אודות הפעולות שלך על-גבי המסך בהגדרות אלו ואודות יישומים שמשתמשים ב-Ad-ID שלך כדי לשפר את השירותים שלנו.</string>
    <string name="opendevice_item_more_settings">מידע נוסף</string>
    <string name="opendevice_item_oaid_desc">ה-Ad-ID שלך (הידוע גם כ-OAID) הוא מזהה התקן זמני שמשמש כדי לספק לך פרסומות מותאמות אישית.</string>
    <string name="opendevice_item_reset_ad">אפס את Ad-ID</string>
    <string name="opendevice_item_reset_ad_des">ניתן לבטל את ההסכמה לקבלת פרסומות מותאמות אישית שמשתמשות ב-Ad-ID שלך. אם תבטל את ההסכמה, עדיין תקבל פרסומות, אבל הן עשויות להיות פחות רלוונטיות עבורך.</string>
    <string name="opendevice_item_reset_ad_des_new">ניתן לבטל את ההסכמה לקבלת הפרסומות המותאמות אישית שמשתמשות ב-Ad-ID. אם תבטל את ההסכמה עדיין תקבל פרסומות, אבל הן עשויות להיות פחות רלוונטיות עבורך.</string>
    <string name="opendevice_item_your_oaid">ה-OAID שלך</string>
    <string name="opendevice_item_your_oaid_desc">Ad-ID שלך (הידוע גם בשם OAID) הוא מזהה התקן זמני המשמש לאספקת פרסומות מותאמות אישית. למידע נוסף, גע %1$s.</string>

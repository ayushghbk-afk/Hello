    <string name="opendevice_personalized_info_desc">"אתה יכול למנוע מיישומים להשתמש בנתונים אלה כדי לספק פרסומות מותאמות אישית על-ידי השבתת 'פרסומות מותאמות אישית' בהגדרות שלהם. לאחר ההשבתה, עדיין תקבל את אותו מספר פרסומות, אבל הן יהיו פחות רלוונטיות עבורך."</string>
    <string name="opendevice_petal_info_desc_tv">‏HUAWEI Ads הוא שירות פרסום המסופק על-ידי Huawei Software Technologies Co., Ltd.‎ דרך הפלטפורמה Petal Ads. הפרטיות שלך מוגנת בעת השימוש בשירות זה. למידע נוסף, ראה:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">אפשר לכל היישומים לעקוב</string>
    <string name="opendevice_pps_privacy_info_desc_more">למידע נוסף</string>
    <string name="opendevice_pps_privacy_info_desc_tv">כשאפשרות זו מופעלת, כל היישומים יוכלו לגשת למזהה הפרסום (OAID) שלך. כשאפשרות זו מושבתת, רק ליישומים שנבחרו למטה מותר לגשת.</string>
    <string name="opendevice_pps_privacy_oaid_desc">מזהה התקן אנונימי פתוח (OAID) הוא מזהה התקן שאינו קבוע המאפשר למפתחי יישומים לעקוב אחר הפעילות שלך ולהגיש תוכן מותאם אישית בלי לחשוף את הנתונים האישיים שלך. אם השבתת את המעקב עבור כל היישומים, OAID חדש יוקצה בפעם הבאה שתאפשר ליישום לעקוב אחר הפעילות שלך.</string>
    <string name="opendevice_pps_privacy_petal_ads">‏HUAWEI Ads</string>
    <string name="opendevice_pps_privacy_track_app_info">יישומים שביקשו לעקוב אחר הפעילות שלך באמצעות המזהה שלך יוצגו כאן. פעילות המעקב חסומה בפני יישומים שסירבת לתת להם גישה.</string>
    <string name="opendevice_pps_privacy_view_oaid">הצג OAID</string>
    <string name="opendevice_privacy_desc">שירותי פרסום מותאמים אישית ממליצים על תוכן שאתה עשוי להיות מעוניין בו. אנו נשמור על הפרטיות שלך בכל עת. לפרטים נוספים, יש לעיין ב%1$s.</string>
    <string name="opendevice_privacy_desc_new">שירותי פרסומות מותאמות אישית ממליצות על תוכן שאתה עשוי להיות מעוניין בו. אנו נגן על הפרטיות שלך בכל עת. למידע נוסף, ראה:</string>
    <string name="opendevice_privacy_oversea_desc">הפלטפורמה Petal Ads מספקת שירותי פרסום עבור Huawei Mobile Services ויישומי צד שלישי. אם פרסומות מותאמות אישית מופעלות, יתכן שייעשה שימוש בנתונים האישיים שלך כדי לספק לך פרסומות רלוונטיות ושימושיות יותר. למידע נוסף אודות אופן השימוש בנתונים שלך ואודות זכויותיך, עיין ב%1$s.</string>
    <string name="opendevice_privacy_oversea_desc_new">פלטפורמת Petal Ads מספקת שירותי פרסום עבור השירותים הניידים של Huawei ויישומי צד שלישי. אם פרסומות מותאמות אישית מופעלות, ניתן להשתמש בנתונים האישיים שלכם על מנת לספק לכם פרסומות יותר רלוונטיות ושימושיות. למידע נוסף אודות האופן שבו נעשה שימוש בנתונים שלכם וזכויותיכם, אנא עיינו במסמכים הבאים:</string>
    <string name="opendevice_recommend_ad_desc">חברת Huawei מספקת פרסומות שעשויות להיות שימושיות עבורך תוך שימוש בטכנולוגיות מתקדמות על-מנת להבטיח הגנה על פרטיותך.</string>
    <string name="opendevice_recommend_desc">תכונה זו משתמשת בטכנולוגיית לימוד בשיתוף פעולה כדי להמליץ על מוצרים ועל שירותים שאתה עשוי לאהוב.</string>

    <string name="opendevice_directional_info_desc_tv">Voit katsoa mainontasegmenttitiedot, joita Petal Mainokset -alusta käyttää personoitujen mainosten tarjoamiseen, puhelimen tai muun laitteen Tietosuojakeskuksesta (%1$s).</string>
    <string name="opendevice_dlg_msg_ad_reset">Uusi Ad-ID määritetään satunnaisesti.</string>

    <string name="opendevice_directional_info">Vis oplysninger om reklamemålretning</string>
    <string name="opendevice_directional_info_desc_tv">For at få vist de oplysninger om reklamesegmentering, som platformen Petal-reklamer bruger til at levere personligt tilpassede reklamer, skal du gå til Privatlivscenter (%1$s) på din telefon eller en anden enhed.</string>
    <string name="opendevice_dlg_msg_ad_reset">Der vil blive tildelt et nyt, tilfældigt reklame-id.</string>
    <string name="opendevice_dlg_title_reset_ad">Nulstil reklame-id</string>
    <string name="opendevice_here">her</string>
    <string name="opendevice_hw_ad_service">Reklamer og personlige oplysninger</string>
    <string name="opendevice_hw_ad_service_new">Reklamer</string>
    <string name="opendevice_item_ad_reset_desc">Du kan fravælge brugertilpassede annoncer, som bruger dit Ad-ID. Hvis du fravælger dette, modtager du fortsat annoncer, men de vil være mindre relevante for dig. %1$s</string>
    <string name="opendevice_item_collection_ad_desc_more_info">Få mere at vide om databrug og dine rettigheder</string>
    <string name="opendevice_item_disable_collection_ad">Deaktiver indsamling af statistik for reklame-id</string>
    <string name="opendevice_item_disable_collection_ad_desc">Vi indsamler oplysninger om dine handlinger på skærmen i disse indstillinger og om apps, der bruger dit reklame-id, for at forbedre vores tjenester. Hvis du ønsker flere oplysninger om, hvordan vi bruger disse data, kan du trykke %1$s.</string>
    <string name="opendevice_item_disable_collection_ad_desc_new">Vi indsamler oplysninger om dine skærmhandlinger i disse indstillinger og om apps, der bruger dit reklame-id, for at forbedre vores tjenester.</string>
    <string name="opendevice_item_more_settings">Flere oplysninger</string>
    <string name="opendevice_item_oaid_desc">Dit Ad-ID (også kendt som et OAID) er en midlertidig enhedsidentifikator, som bruges til at levere brugertilpassede annoncer.</string>
    <string name="opendevice_item_reset_ad">Nulstil reklame-id</string>
    <string name="opendevice_item_reset_ad_des">Du kan fravælge personlige annoncer, som bruger dit reklame-id. Hvis du fravælger dette, vil du stadig se annoncer, men de vil være mindre relevante for dig.</string>
    <string name="opendevice_item_reset_ad_des_new">Du kan fravælge modtagelse af personligt tilpassede reklamer, der bruger dit reklame-id. Hvis du fravælger, vil du stadig modtage reklamer, men de vil muligvis være mindre relevante for dig.</string>
    <string name="opendevice_item_your_oaid">Dit OAID</string>
    <string name="opendevice_item_your_oaid_desc">Dit reklame-id (kaldes også et OAID) er en midlertidig enhedsidentifikator, som bruges til at levere personligt tilpassede annoncer. Du kan få mere at vide ved at trykke på %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Deaktiver personligt tilpassede reklamer</string>
    <string name="opendevice_limit_ad_tracking_detail">Flere oplysninger</string>
    <string name="opendevice_limit_recommend">Smarte anbefalinger</string>
    <string name="opendevice_network_no_available">Ingen internetforbindelse</string>
    <string name="opendevice_personalized_info_desc">Du kan forhindre apps i at bruge disse data til at levere personligt tilpassede reklamer ved at deaktivere \"Personligt tilpassede reklamer\" i deres indstillinger. Når dette er deaktiveret, modtager du fortsat det samme antal reklamer, men de vil være mindre relevante for dig.</string>
    <string name="opendevice_petal_info_desc_tv">HUAWEI-reklamer er en annonceringstjeneste, der udbydes af Huawei Software Technologies Co., Ltd. via platformen Petal-reklamer. Dine personlige oplysninger er beskyttede, når du bruger denne tjeneste. Du kan finde flere oplysninger i følgende:</string>
    <string name="opendevice_pps_privacy_allow_app_tracking">Tillad sporing for alle apps</string>
    <string name="opendevice_pps_privacy_info_desc_more">Flere oplysninger</string>
    <string name="opendevice_pps_privacy_info_desc_tv">Når funktionen er aktiveret, kan alle apps få adgang til din reklameidentifikator (OAID). Når funktionen er deaktiveret, har kun de nedenfor valgte apps adgang.</string>
    <string name="opendevice_pps_privacy_oaid_desc">Din åbne anonyme enhedsidentifikator (OAID) er en ikke-permanent enhedsidentifikator, som gør det muligt for appudviklere at spore din aktivitet og levere personligt tilpasset indhold uden at afsløre dine personlige data. Hvis du har deaktiveret sporing for alle apps, tildeles en ny OAID, næste gang du tillader en app at spore din aktivitet.</string>
    <string name="opendevice_pps_privacy_petal_ads">HUAWEI-reklamer</string>
    <string name="opendevice_pps_privacy_track_app_info">Apps, der har anmodet om sporing af din aktivitet med din identifikator, vises her. Sporingsaktivitet er blokeret for apps, hvis adgang du afviser.</string>
    <string name="opendevice_pps_privacy_view_oaid">Vis OAID</string>
    <string name="opendevice_privacy_desc">Brugertilpassede annonceringstjenester anbefaler indhold, som måske vil interessere dig. Dine personlige oplysninger er altid beskyttet. Få flere oplysninger ved at se vores %1$s.</string>
    <string name="opendevice_privacy_desc_new">Personligt tilpassede reklametjenester anbefaler indhold, som du måske vil være interesseret i. Dine personlige oplysninger vil altid blive beskyttet. Du kan finde flere oplysninger her:</string>
    <string name="opendevice_privacy_oversea_desc">Platformen Petal-reklamer leverer reklametjenester til Huawei Mobile Services og apps fra tredjeparter. Hvis personlige reklamer er aktiveret, kan dine personlige data blive brugt til at give dig mere relevante og nyttige reklamer. Hvis du vil vide mere om, hvordan dine data bruges, og om dine rettigheder, kan du læse mere i vores %1$s.</string>
    <string name="opendevice_privacy_oversea_desc_new">Platformen Petal-reklamer leverer annoncetjenester til Huaweis mobile tjenester og til tredjeparts-apps. Hvis personligt tilpassede reklamer er aktiveret, kan dine personlige data bruges til at levere mere relevante og nyttige reklamer til dig. Hvis du vil have flere oplysninger om, hvordan dine data bruges, og om dine rettigheder, kan du se følgende:</string>
    <string name="opendevice_recommend_ad_desc">Huawei leverer annoncer, som du kan finde nyttige, samtidig med at der anvendes avancerede teknologier for at sikre, at dine personlige oplysninger er beskyttede.</string>
    <string name="opendevice_recommend_desc">Denne funktion bruger federated learning-teknologi til at anbefale produkter og tjenester, som du måske kan lide.</string>

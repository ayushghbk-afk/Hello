    <string name="opendevice_item_your_oaid">Tu OAID</string>
    <string name="opendevice_item_your_oaid_desc">Su ID de anuncios (también OAID) es un identificador de dispositivo temporario usado para proporcionarle anuncios personalizados. Para obtener más información, presione %1$s.</string>
    <string name="opendevice_limit_ad_tracking">Deshabilitar anuncios personalizados</string>
    <string name="opendevice_limit_ad_tracking_detail">Más información</string>
